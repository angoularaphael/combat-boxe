---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MonthArchive from '../../components/MonthArchive.astro';
import { combats, formatDate } from '../../data/entities';
import { groupItemsByMonth, isUpcomingDate, parisTodayKey } from '../../lib/archive';
import { breadcrumbLd, graph } from '../../lib/seo';

const todayKey = parisTodayKey();
const past = combats
  .filter((c) => !isUpcomingDate(c.date, todayKey))
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const months = groupItemsByMonth(past);
const path = '/archives/calendrier';
const crumbs = [
  { href: '/', label: 'Accueil' },
  { href: '/archives', label: 'Archives' },
  { href: path, label: 'Calendrier' },
];
const jsonLd = graph(breadcrumbLd(crumbs));
---

<Base
  title="Archives du calendrier | Combat Boxe"
  description="Archives du calendrier des combats de boxe : mois passés, consultables hors du calendrier courant."
  path={path}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <article class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        {crumbs.map((c, i) => (
          <li>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ol>
      <h1>Archives du calendrier</h1>
      <p class="lede">
        Combats des dates déjà passées. Le calendrier courant est sur{' '}
        <a href="/calendrier-combats-boxe">Calendrier</a>.
      </p>
      {months.length === 0 ? (
        <p class="empty">Aucune archive de calendrier pour l’instant.</p>
      ) : (
        <div class="days-months">
          {months.map(([ym, items], index) => {
            const dates = [...new Set(items.map((c) => c.date))].sort((a, b) => String(b).localeCompare(String(a)));
            return (
              <MonthArchive ym={ym} count={items.length} open={index === 0} unit="combat" unitPlural="combats">
                <div class="day-list">
                  {dates.map((date) => {
                    const dayFights = items.filter((c) => c.date === date);
                    return (
                      <section>
                        <h2>{formatDate(date)}</h2>
                        <ul>
                          {dayFights.map((fight) => (
                            <li>
                              <a href={fight.href}>
                                {fight.boxerA} contre {fight.boxerB}
                              </a>
                              {fight.category ? ` · ${fight.category}` : ''}
                              {fight.status === 'dispute' && fight.winner ? ` · ${fight.winner}` : ''}
                              {fight.status === 'a-venir' ? ' · en attente de verdict' : ''}
                            </li>
                          ))}
                        </ul>
                      </section>
                    );
                  })}
                </div>
              </MonthArchive>
            );
          })}
        </div>
      )}
    </div>
  </article>
  <Footer slot="footer" />
</Base>
