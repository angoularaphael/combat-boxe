---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { boxeurs, clubs, coachs, combats, galas, formatDate, groupArticlesByDay, kindLabel, liveArticle } from '../data/entities';
import { editionPath, editionTitle } from '../lib/archive';
import { articleLd, breadcrumbLd, collectionLd, graph } from '../lib/seo';
import { articleThumb, photosForVersus } from '../lib/portraits';
import Cover from '../components/Cover.astro';
import DaysNav from '../components/DaysNav.astro';
import FightCard from '../components/FightCard.astro';
import GalaCard from '../components/GalaCard.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const articles = (await getCollection('articles')).filter((a) => a.data.status === 'published');
  return [...pages, ...articles].map((entry) => ({ params: { slug: entry.data.slug } }));
}

const { slug } = Astro.params;
const pages = await getCollection('pages');
const articles = (await getCollection('articles'))
  .filter((a) => a.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entry = [...pages, ...articles].find((item) => item.data.slug === slug);
const mode = entry && articles.some((item) => item.id === entry.id) ? 'article' : 'page';
const { Content } = await render(entry);
const data = liveArticle(entry.data);
const path = `/${data.slug}`;
const crumbs = [{ href: '/', label: 'Accueil' }, ...data.breadcrumbs];
const template = mode === 'page' ? data.template : 'article';
const portraitImage = Boolean(data.photo);
const linkedBoxer = data.boxeur || boxeurs.find((b) => b.article === data.slug);
const coverPhotos = photosForVersus(data.coverVersus || '');
const editions = groupArticlesByDay(articles);
const listing = ['news', 'upcoming', 'results', 'calendar', 'galas', 'boxers-fr', 'boxers-int', 'clubs', 'coaches', 'portraits', 'analyses', 'interviews', 'dossiers'].includes(template);
const showPhoto = template !== 'legal' && portraitImage;
const showCover = template !== 'legal' && !listing && !portraitImage;
const image = data.photo || coverPhotos[0] || data.image || '/img/og-combat-boxe.jpg';
const jsonLd = graph(
  breadcrumbLd(crumbs),
  mode === 'article'
    ? articleLd({
        title: data.h1,
        description: data.description,
        path,
        date: data.date,
        image,
      })
    : template === 'news'
      ? collectionLd({
          title: data.h1,
          description: data.description,
          path,
          items: articles.map((a) => ({ data: liveArticle(a.data) })),
        })
      : null,
);

const upcoming = combats
  .filter((c) => c.status === 'a-venir')
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const results = combats
  .filter((c) => c.status === 'dispute')
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const fr = boxeurs.filter((b) => !b.international);
const intl = boxeurs.filter((b) => b.international);
const portraits = articles.filter((a) => a.data.kind === 'portrait');
const analyses = articles.filter((a) => a.data.kind === 'analyse');
const interviews = articles.filter((a) => a.data.kind === 'interview');
const dossiers = articles.filter((a) => a.data.kind === 'dossier' || a.data.kind === 'guide');

function searchBlob(row) {
  return [row.h1, row.title, row.description, row.coverVersus, kindLabel(row.kind)]
    .filter(Boolean)
    .join(' ')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();
}
---

<Base
  title={data.title}
  description={data.description}
  path={path}
  image={image}
  ogType={mode === 'article' ? 'article' : 'website'}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <article class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        {crumbs.map((c, i) => (
          <li>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ol>
      {mode === 'article' && <p class="meta">{formatDate(data.date)} · {kindLabel(data.kind)}</p>}
      <h1>{data.h1}</h1>
      {template === 'news' && <DaysNav editions={editions} label="Actualités par jour" />}
      {showPhoto && (
        <figure class="figure figure-portrait">
          <img src={data.photo} alt={data.imageAlt || ''} width="640" height="800" />
        </figure>
      )}
      {linkedBoxer && mode === 'article' && (
        <dl class="facts facts-live">
          <div>
            <dt>Catégorie</dt>
            <dd>{linkedBoxer.category}</dd>
          </div>
          <div>
            <dt>Classement</dt>
            <dd>{linkedBoxer.ranking}</dd>
          </div>
          <div>
            <dt>Bilan</dt>
            <dd>{linkedBoxer.recordNote}</dd>
          </div>
          <div>
            <dt>Objectif</dt>
            <dd>{linkedBoxer.objectif}</dd>
          </div>
        </dl>
      )}
      {template === 'news' && (
        <>
          <form class="news-search" role="search" action="/actualites" method="get">
            <label for="news-q">Rechercher une actualité</label>
            <input id="news-q" name="q" type="search" placeholder="Nom, ville, titre" autocomplete="off" enterkeyhint="search" />
          </form>
          <p class="empty news-search-empty" hidden>Aucun papier ne correspond à ces mots.</p>
          {editions.map(([key, items]) => (
            <section class="edition-block">
              <div class="section-head">
                <h2>{editionTitle(items[0].data.date)}</h2>
                <a href={editionPath(items[0].data.date)}>Ouvrir le jour</a>
              </div>
              <div class="stack">
                {items.map((item) => {
                  const row = liveArticle(item.data);
                  const thumb = articleThumb(row);
                  return (
                    <a class:list={['row-card', thumb && 'row-card-media']} href={`/${row.slug}`} data-search={searchBlob(row)}>
                      {thumb && <img src={thumb} alt="" width="400" height="250" loading="lazy" />}
                      <div>
                        <p class="meta">{formatDate(row.date)} · {kindLabel(row.kind)}</p>
                        <h3>{row.h1}</h3>
                        <p>{row.description}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
          <script is:inline>
            (function () {
              var input = document.getElementById('news-q');
              var empty = document.querySelector('.news-search-empty');
              if (!input) return;
              function fold(value) {
                return String(value || '')
                  .normalize('NFD')
                  .replace(/[\u0300-\u036f]/g, '')
                  .toLowerCase();
              }
              function apply() {
                var words = fold(input.value).split(/\s+/).filter(Boolean);
                var shown = 0;
                document.querySelectorAll('[data-search]').forEach(function (card) {
                  var hay = card.getAttribute('data-search') || '';
                  var ok = words.every(function (word) { return hay.indexOf(word) !== -1; });
                  card.hidden = !ok;
                  if (ok) shown += 1;
                });
                document.querySelectorAll('.edition-block').forEach(function (block) {
                  var visible = block.querySelector('[data-search]:not([hidden])');
                  block.hidden = !visible;
                });
                if (empty) empty.hidden = shown > 0;
                var url = new URL(window.location.href);
                var text = input.value.trim();
                if (text) url.searchParams.set('q', text);
                else url.searchParams.delete('q');
                history.replaceState(null, '', url);
              }
              input.addEventListener('input', apply);
              var params = new URLSearchParams(window.location.search);
              var initial = params.get('q') || '';
              if (initial) input.value = initial;
              apply();
            })();
          </script>
        </>
      )}

      {(template === 'upcoming' || template === 'results' || template === 'calendar') && (
        (template === 'results' ? results : upcoming).length === 0 ? (
          <p class="empty">
            {template === 'results' ? 'Aucun résultat n’est encore publié.' : 'Aucun combat à venir n’est encore inscrit.'}
          </p>
        ) : (
          <div class="fight-grid">
            {(template === 'results' ? results : upcoming).map((c, index) => (
              <FightCard fight={c} index={index} verdict={template === 'results'} />
            ))}
          </div>
        )
      )}

      {(template === 'upcoming' || template === 'calendar') && results.length > 0 && (
        <>
          <div class="section-head" style="margin-top: 36px">
            <h2>Derniers résultats</h2>
            <a href="/resultats-boxe">Tous les résultats</a>
          </div>
          <div class="fight-grid">
            {results.map((c, index) => (
              <FightCard fight={c} index={index} verdict={true} />
            ))}
          </div>
        </>
      )}

      {showCover && (
        <Cover
          kicker={mode === 'article' ? kindLabel(data.kind) : 'Combat Boxe'}
          versus={data.coverVersus || ''}
          title={data.coverVersus ? '' : data.h1}
          meta={data.coverMeta || ''}
          photos={coverPhotos}
        />
      )}
      <div class="prose">
        <Content />
      </div>

      {template === 'galas' && (
        galas.length === 0 ? (
          <p class="empty">Aucun gala n’est encore inscrit.</p>
        ) : (
          <div class="fight-grid">
            {galas.map((g, index) => (
              <GalaCard gala={g} index={index} />
            ))}
          </div>
        )
      )}

      {template === 'boxers-fr' && (
        <div class="grid cards-2">
          {fr.map((b) => (
            <a class="card" href={`/boxeurs/${b.slug}`}>
              <img src={b.photo} alt={b.photoAlt} width="640" height="800" loading="lazy" />
              <h2>{b.name}</h2>
              <p>{b.category} · {b.ranking}</p>
            </a>
          ))}
        </div>
      )}

      {template === 'boxers-int' && (
        intl.length === 0 ? (
          <p class="empty">Aucun boxeur international n’a encore de fiche.</p>
        ) : (
          <div class="grid cards-2">
            {intl.map((b) => (
              <a class="card" href={`/boxeurs/${b.slug}`}>
                <img src={b.photo || '/img/boxing-ring-corner.jpg'} alt={b.photoAlt || b.name} width="640" height="800" loading="lazy" />
                <h2>{b.name}</h2>
                <p>{b.category}</p>
              </a>
            ))}
          </div>
        )
      )}

      {template === 'portraits' && (
        <div class="stack">
          {portraits.map((item) => {
            const row = liveArticle(item.data);
            const thumb = articleThumb(row);
            return (
            <a class:list={['row-card', thumb && 'row-card-media']} href={`/${row.slug}`}>
              {thumb && <img src={thumb} alt="" width="400" height="250" loading="lazy" />}
              <div>
                <h2>{row.h1}</h2>
                <p>{row.description}</p>
              </div>
            </a>
            );
          })}
        </div>
      )}

      {template === 'clubs' && (
        <div class="grid cards-2">
          {clubs.map((c) => (
            <a class="card" href={`/clubs/${c.slug}`}>
              <img src={c.image || '/img/agenda-clubs.jpg'} alt={c.imageAlt || c.name} width="800" height="450" loading="lazy" />
              <h2>{c.name}</h2>
              <p>{c.city} · {c.disciplines.join(', ')}</p>
            </a>
          ))}
        </div>
      )}

      {template === 'coaches' && (
        <div class="grid cards-2">
          {coachs.map((c) => (
            <a class="card" href={`/coachs/${c.slug}`}>
              <img src={c.photo} alt={c.photoAlt} width="640" height="800" loading="lazy" />
              <h2>{c.name}</h2>
              <p>{c.city} · {c.diplomes.join(', ')}</p>
            </a>
          ))}
        </div>
      )}

      {template === 'analyses' && (
        analyses.length === 0 ? (
          <p class="empty">Les analyses arriveront après les rendez-vous.</p>
        ) : (
          <div class="stack">
            {analyses.map((item) => (
              <a class="row-card" href={`/${item.data.slug}`}>
                <h2>{item.data.h1}</h2>
                <p>{item.data.description}</p>
              </a>
            ))}
          </div>
        )
      )}

      {template === 'interviews' && (
        interviews.length === 0 ? (
          <p class="empty">Aucune interview n’est encore publiée.</p>
        ) : (
          <div class="stack">
            {interviews.map((item) => (
              <a class="row-card" href={`/${item.data.slug}`}>
                <h2>{item.data.h1}</h2>
              </a>
            ))}
          </div>
        )
      )}

      {template === 'dossiers' && (
        dossiers.length === 0 ? (
          <p class="empty">Aucun dossier n’est encore publié.</p>
        ) : (
          <div class="stack">
            {dossiers.map((item) => (
              <a class="row-card" href={`/${item.data.slug}`}>
                <h2>{item.data.h1}</h2>
                <p>{item.data.description}</p>
              </a>
            ))}
          </div>
        )
      )}

      {mode === 'article' && data.pillars?.length > 0 && (
        <nav class="also" aria-label="Maillage">
          {data.pillars.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      )}
    </div>
  </article>
  <Footer slot="footer" />
</Base>
