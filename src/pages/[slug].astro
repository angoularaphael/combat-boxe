---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { boxeurs, clubs, coachs, combats, galas, formatDate, groupArticlesByDay, kindLabel, liveArticle } from '../data/entities';
import {
  currentMonthEditions,
  currentMonthItems,
  currentMonthKey,
  editionPath,
  editionTitle,
  groupItemsByMonth,
  isUpcomingCombat,
  isUpcomingDate,
  parisTodayKey,
} from '../lib/archive';
import { articleLd, breadcrumbLd, collectionLd, graph } from '../lib/seo';
import { articleThumb, photosForVersus } from '../lib/portraits';
import Cover from '../components/Cover.astro';
import DaysNav from '../components/DaysNav.astro';
import MonthArchive from '../components/MonthArchive.astro';
import BoxerCard from '../components/BoxerCard.astro';
import BoxerSwitch from '../components/BoxerSwitch.astro';
import FightCard from '../components/FightCard.astro';
import GalaCard from '../components/GalaCard.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const articles = (await getCollection('articles')).filter((a) => a.data.status === 'published');
  return [...pages, ...articles].map((entry) => ({ params: { slug: entry.data.slug } }));
}

const { slug } = Astro.params;
const pages = await getCollection('pages');
const articles = (await getCollection('articles'))
  .filter((a) => a.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entry = [...pages, ...articles].find((item) => item.data.slug === slug);
const mode = entry && articles.some((item) => item.id === entry.id) ? 'article' : 'page';
const { Content } = await render(entry);
const data = liveArticle(entry.data);
const path = `/${data.slug}`;
const crumbs = [{ href: '/', label: 'Accueil' }, ...data.breadcrumbs];
const template = mode === 'page' ? data.template : 'article';
const portraitImage = Boolean(data.photo);
const linkedBoxer = data.boxeur || boxeurs.find((b) => b.article === data.slug);
const coverPhotos = photosForVersus(data.coverVersus || '');
const editions = groupArticlesByDay(articles);
const listing = ['news', 'upcoming', 'results', 'calendar', 'galas', 'boxers-fr', 'boxers-int', 'clubs', 'coaches', 'portraits', 'analyses', 'interviews', 'dossiers'].includes(template);
const showPhoto = template !== 'legal' && portraitImage;
const showCover = template !== 'legal' && !listing && !portraitImage;
const image = data.photo || coverPhotos[0] || data.image || '/img/og-combat-boxe.jpg';
const jsonLd = graph(
  breadcrumbLd(crumbs),
  mode === 'article'
    ? articleLd({
        title: data.h1,
        description: data.description,
        path,
        date: data.date,
        image,
      })
    : template === 'news'
      ? collectionLd({
          title: data.h1,
          description: data.description,
          path,
          items: articles.map((a) => ({ data: liveArticle(a.data) })),
        })
      : null,
);

const todayKey = parisTodayKey();
const currentMonth = currentMonthKey(todayKey);
const liveEditions = currentMonthEditions(editions, todayKey);
const upcoming = combats
  .filter((c) => isUpcomingCombat(c, todayKey))
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const resultsLive = currentMonthItems(
  combats.filter((c) => c.status === 'dispute').sort((a, b) => String(b.date).localeCompare(String(a.date))),
  (c) => c.date,
  todayKey,
);
const upcomingByMonth = groupItemsByMonth(upcoming);
const calendarLive = combats
  .filter((c) => isUpcomingDate(c.date, todayKey) || String(c.date).startsWith(currentMonth))
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const calendarByMonth = groupItemsByMonth(calendarLive);
const galasUpcoming = galas
  .filter((g) => isUpcomingDate(g.date, todayKey))
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const galasUpcomingByMonth = groupItemsByMonth(galasUpcoming);
const fr = boxeurs.filter((b) => !b.international);
const intl = boxeurs.filter((b) => b.international);
const portraits = articles.filter((a) => a.data.kind === 'portrait');
const analyses = articles.filter((a) => a.data.kind === 'analyse');
const interviews = articles.filter((a) => a.data.kind === 'interview');
const dossiers = articles.filter((a) => a.data.kind === 'dossier' || a.data.kind === 'guide');
---

<Base
  title={data.title}
  description={data.description}
  path={path}
  image={image}
  ogType={mode === 'article' ? 'article' : 'website'}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <article class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        {crumbs.map((c, i) => (
          <li>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ol>
      {mode === 'article' && <p class="meta">{formatDate(data.date)} · {kindLabel(data.kind)}</p>}
      <h1>{data.h1}</h1>
      {(template === 'boxers-fr' || template === 'boxers-int') && (
        <BoxerSwitch current={template === 'boxers-fr' ? 'fr' : 'int'} />
      )}
      {template === 'news' && (
        <>
          <DaysNav editions={liveEditions} label="Actualités du mois" />
          <p class="card-out"><a href="/archives/actualites">Archives des actualités</a></p>
        </>
      )}
      {showPhoto && (
        <figure class="figure figure-portrait">
          <img src={data.photo} alt={data.imageAlt || ''} width="640" height="800" />
        </figure>
      )}
      {linkedBoxer && mode === 'article' && (
        <dl class="facts facts-live">
          <div>
            <dt>Catégorie</dt>
            <dd>{linkedBoxer.category}</dd>
          </div>
          <div>
            <dt>Classement</dt>
            <dd>{linkedBoxer.ranking}</dd>
          </div>
          <div>
            <dt>Bilan</dt>
            <dd>{linkedBoxer.recordNote}</dd>
          </div>
          <div>
            <dt>Objectif</dt>
            <dd>{linkedBoxer.objectif}</dd>
          </div>
        </dl>
      )}
      {template === 'news' && (
        <div class="news-live">
          {liveEditions.length === 0 ? (
            <p class="empty">Aucun papier ce mois-ci pour l’instant.</p>
          ) : (
            liveEditions.map(([, items]) => (
              <section class="edition-block">
                <div class="section-head">
                  <h2>{editionTitle(items[0].data.date)}</h2>
                  <a href={editionPath(items[0].data.date)}>Ouvrir le jour</a>
                </div>
                <div class="stack">
                  {items.map((item) => {
                    const row = liveArticle(item.data);
                    const thumb = articleThumb(row);
                    return (
                      <a class:list={['row-card', thumb && 'row-card-media']} href={`/${row.slug}`}>
                        {thumb && <img src={thumb} alt="" width="400" height="250" loading="lazy" />}
                        <div>
                          <p class="meta">{formatDate(row.date)} · {kindLabel(row.kind)}</p>
                          <h3>{row.h1}</h3>
                          <p>{row.description}</p>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </section>
            ))
          )}
          <p class="card-out"><a href="/archives/actualites">Consulter les archives</a></p>
        </div>
      )}
      {template === 'news' && (
        <script is:inline>
          (function () {
            var q = (new URLSearchParams(location.search).get('q') || '').trim().toLowerCase();
            if (!q) return;
            document.querySelectorAll('.row-card').forEach(function (card) {
              var text = (card.textContent || '').toLowerCase();
              if (text.indexOf(q) === -1) card.hidden = true;
            });
          })();
        </script>
      )}

      {showCover && (
        <Cover
          kicker={mode === 'article' ? kindLabel(data.kind) : 'Combat Boxe'}
          versus={data.coverVersus || ''}
          title={data.coverVersus ? '' : data.h1}
          meta={data.coverMeta || ''}
          photos={coverPhotos}
        />
      )}
      <div class="prose">
        <Content />
      </div>

      {template === 'upcoming' && (
        upcoming.length === 0 ? (
          <p class="empty">Aucun combat à venir n’est encore inscrit.</p>
        ) : (
          <div class="days-months">
            <p class="days-nav-label">Combats à venir</p>
            {upcomingByMonth.map(([ym, items], index) => (
              <MonthArchive
                ym={ym}
                count={items.length}
                open={ym === currentMonth || index === 0}
                unit="combat"
                unitPlural="combats"
              >
                <div class="fight-grid">
                  {[...items]
                    .sort((a, b) => String(a.date).localeCompare(String(b.date)))
                    .map((c, i) => (
                      <FightCard fight={c} index={i} />
                    ))}
                </div>
              </MonthArchive>
            ))}
          </div>
        )
      )}
      {template === 'upcoming' && (
        <p class="card-out">
          <a href="/resultats-boxe">Résultats du mois</a>
          <a href="/archives/resultats">Archives des résultats</a>
        </p>
      )}

      {template === 'calendar' && (
        <div class="days-months">
          <p class="days-nav-label">Calendrier en cours</p>
          {calendarByMonth.length === 0 ? (
            <p class="empty">Aucun combat inscrit sur la période courante.</p>
          ) : (
            calendarByMonth.map(([ym, items], index) => {
              const dates = [...new Set(items.map((c) => c.date))];
              return (
                <MonthArchive
                  ym={ym}
                  count={items.length}
                  open={ym === currentMonth || index === 0}
                  unit="combat"
                  unitPlural="combats"
                >
                  <div class="day-list">
                    {[...dates].sort((a, b) => String(a).localeCompare(String(b))).map((date) => {
                      const dayFights = items.filter((c) => c.date === date);
                      return (
                        <section>
                          <h2>{formatDate(date)}</h2>
                          <ul>
                            {dayFights.map((fight) => (
                              <li>
                                <a href={fight.href}>{fight.boxerA} contre {fight.boxerB}</a>
                                {fight.category ? ` · ${fight.category}` : ''}
                                {fight.status === 'dispute' && fight.winner ? ` · ${fight.winner}` : ''}
                              </li>
                            ))}
                          </ul>
                        </section>
                      );
                    })}
                  </div>
                </MonthArchive>
              );
            })
          )}
          <p class="card-out"><a href="/archives/calendrier">Archives du calendrier</a></p>
        </div>
      )}

      {template === 'results' && (
        resultsLive.length === 0 ? (
          <>
            <p class="empty">Aucun résultat ce mois-ci pour l’instant.</p>
            <p class="card-out"><a href="/archives/resultats">Consulter les archives</a></p>
          </>
        ) : (
          <div class="days-months">
            <p class="days-nav-label">Résultats du mois</p>
            <div class="fight-grid">
              {resultsLive.map((c, i) => (
                <FightCard fight={c} index={i} verdict={true} />
              ))}
            </div>
            <p class="card-out"><a href="/archives/resultats">Archives des résultats</a></p>
          </div>
        )
      )}

      {template === 'galas' && (
        galasUpcoming.length === 0 ? (
          <>
            <p class="empty">Aucun gala à venir n’est encore inscrit.</p>
            <p class="card-out"><a href="/archives/galas">Archives des galas</a></p>
          </>
        ) : (
          <div class="days-months">
            <p class="days-nav-label">Galas à venir</p>
            {galasUpcomingByMonth.map(([ym, items], index) => (
              <MonthArchive
                ym={ym}
                count={items.length}
                open={ym === currentMonth || index === 0}
                unit="gala"
                unitPlural="galas"
              >
                <div class="fight-grid">
                  {items.map((g, i) => (
                    <GalaCard gala={g} index={i} />
                  ))}
                </div>
              </MonthArchive>
            ))}
            <p class="card-out"><a href="/archives/galas">Archives des galas</a></p>
          </div>
        )
      )}

      {template === 'boxers-fr' && (
        <div class="boxer-grid">
          {fr.map((b) => (
            <BoxerCard boxeur={b} />
          ))}
        </div>
      )}

      {template === 'boxers-int' && (
        intl.length === 0 ? (
          <p class="empty">Aucun boxeur international n’a encore de fiche.</p>
        ) : (
          <div class="boxer-grid">
            {intl.map((b) => (
              <BoxerCard boxeur={b} />
            ))}
          </div>
        )
      )}

      {template === 'portraits' && (
        <div class="stack">
          {portraits.map((item) => {
            const row = liveArticle(item.data);
            const thumb = articleThumb(row);
            return (
            <a class:list={['row-card', thumb && 'row-card-media']} href={`/${row.slug}`}>
              {thumb && <img src={thumb} alt="" width="400" height="250" loading="lazy" />}
              <div>
                <h2>{row.h1}</h2>
                <p>{row.description}</p>
              </div>
            </a>
            );
          })}
        </div>
      )}

      {template === 'clubs' && (
        <div class="grid cards-2">
          {clubs.map((c) => (
            <article class="card card-salle">
              <a class="stretch" href={`/clubs/${c.slug}`}>
                {c.image && <img src={c.image} alt={c.imageAlt || c.name} width="1200" height="750" loading="lazy" />}
                <h2>{c.name}</h2>
                <p>{c.address}</p>
              </a>
              <p class="card-out">
                <a href={c.url}>{c.urlLabel || 'Site de la salle'}</a>
                {c.centerUrl && <a href={c.centerUrl}>Boxing Center</a>}
              </p>
            </article>
          ))}
        </div>
      )}

      {template === 'coaches' && (
        <div class="grid cards-2">
          {coachs.map((c) => (
            <a class="card" href={`/coachs/${c.slug}`}>
              {c.photo && <img src={c.photo} alt={c.photoAlt || c.name} width="640" height="800" loading="lazy" />}
              <h2>{c.name}</h2>
              <p>{c.city}{c.role ? ` · ${c.role}` : ''}</p>
            </a>
          ))}
        </div>
      )}

      {template === 'analyses' && (
        analyses.length === 0 ? (
          <p class="empty">Les analyses arriveront après les rendez-vous.</p>
        ) : (
          <div class="stack">
            {analyses.map((item) => (
              <a class="row-card" href={`/${item.data.slug}`}>
                <h2>{item.data.h1}</h2>
                <p>{item.data.description}</p>
              </a>
            ))}
          </div>
        )
      )}

      {template === 'interviews' && (
        interviews.length === 0 ? (
          <p class="empty">Aucune interview n’est encore publiée.</p>
        ) : (
          <div class="stack">
            {interviews.map((item) => (
              <a class="row-card" href={`/${item.data.slug}`}>
                <h2>{item.data.h1}</h2>
              </a>
            ))}
          </div>
        )
      )}

      {template === 'dossiers' && (
        dossiers.length === 0 ? (
          <p class="empty">Aucun dossier n’est encore publié.</p>
        ) : (
          <div class="stack">
            {dossiers.map((item) => (
              <a class="row-card" href={`/${item.data.slug}`}>
                <h2>{item.data.h1}</h2>
                <p>{item.data.description}</p>
              </a>
            ))}
          </div>
        )
      )}

      {mode === 'article' && data.pillars?.length > 0 && (
        <nav class="also" aria-label="Maillage">
          {data.pillars.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      )}
    </div>
  </article>
  <Footer slot="footer" />
</Base>
