---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cover from '../../components/Cover.astro';
import ClipRow from '../../components/ClipRow.astro';
import { combats, formatDate, galas } from '../../data/entities';
import { countryLabel, flagSrc, placeLine } from '../../lib/flags';
import { fightMedia } from '../../lib/portraits';
import { breadcrumbLd, graph } from '../../lib/seo';

export function getStaticPaths() {
  return combats.map((fight) => ({ params: { slug: fight.slug }, props: { fight } }));
}

const { fight } = Astro.props;
const path = `/combats/${fight.slug}`;
const photos = fightMedia(`${fight.boxerA} / ${fight.boxerB}`).srcs;
const flag = flagSrc(fight.country);
const country = countryLabel(fight.country);
function cityKey(value = '') {
  return String(value)
    .split(',')[0]
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}
const relatedGala = galas.find((gala) => gala.date === fight.date && cityKey(gala.city) === cityKey(fight.city));
const sameCard = combats.filter(
  (item) => item.slug !== fight.slug && item.date === fight.date && cityKey(item.city) === cityKey(fight.city),
);
const place = placeLine(fight.city, country);
const paragraphs = (value) => String(value || '').split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
const analysis = paragraphs(fight.analysis);
const prediction = fight.status === 'dispute' ? [] : paragraphs(fight.prediction);
const crumbs = [
  { href: '/', label: 'Accueil' },
  { href: fight.status === 'dispute' ? '/resultats-boxe' : '/combats-a-venir', label: fight.status === 'dispute' ? 'Résultats' : 'Combats à venir' },
  { href: path, label: `${fight.boxerA} contre ${fight.boxerB}` },
];
const title = `${fight.boxerA} contre ${fight.boxerB} | Combat Boxe`;
const description = `${fight.boxerA} contre ${fight.boxerB}, ${formatDate(fight.date)}, ${fight.city}. ${fight.titles || fight.category}.`;
---

<Base title={title} description={description} path={path} image={photos[0] || '/img/og-combat-boxe.jpg'} jsonLd={graph(breadcrumbLd(crumbs))}>
  <Header slot="header" />
  <article class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        {crumbs.map((c, i) => (
          <li>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ol>
      <p class="meta">
        {flag && <img class="fight-flag" src={flag} alt="" title={country} width="24" height="16" />}
        {formatDate(fight.date)} · {place}
      </p>
      <h1>{fight.boxerA} contre {fight.boxerB}</h1>
      <Cover
        kicker={fight.status === 'dispute' ? 'Résultat' : 'Combat'}
        versus={`${fight.boxerA} / ${fight.boxerB}`}
        meta={`${formatDate(fight.date)} · ${fight.city} · ${fight.category}`}
        photos={photos}
      />
      <dl class="facts facts-live">
        <div>
          <dt>Catégorie</dt>
          <dd>{fight.category}</dd>
        </div>
        {fight.titles && (
          <div>
            <dt>Titre</dt>
            <dd>{fight.titles}</dd>
          </div>
        )}
        <div>
          <dt>Lieu</dt>
          <dd>{place}</dd>
        </div>
        {fight.venue && (
          <div>
            <dt>Salle</dt>
            <dd>{fight.venue}</dd>
          </div>
        )}
        {fight.time && (
          <div>
            <dt>Heure</dt>
            <dd>{fight.time}</dd>
          </div>
        )}
        {fight.channel && (
          <div>
            <dt>Diffusion</dt>
            <dd>{fight.channel}</dd>
          </div>
        )}
        {fight.status === 'dispute' && (
          <>
            <div>
              <dt>Vainqueur</dt>
              <dd>{fight.winner}</dd>
            </div>
            <div>
              <dt>Verdict</dt>
              <dd>{fight.method}{fight.decision ? ` · ${fight.decision}` : ''}</dd>
            </div>
          </>
        )}
      </dl>
      {analysis.length > 0 ? (
        <div class="fight-read">
          {analysis.map((part) => <p>{part}</p>)}
        </div>
      ) : fight.stakes && <p class="lead">{fight.stakes}</p>}
      <ClipRow clips={fight.clips} />
      {(fight.aboutA || fight.aboutB) && (
        <div class="person-grid">
          {fight.aboutA && (
            <section>
              <h2>{fight.boxerA}</h2>
              <p>{fight.aboutA}</p>
            </section>
          )}
          {fight.aboutB && (
            <section>
              <h2>{fight.boxerB}</h2>
              <p>{fight.aboutB}</p>
            </section>
          )}
        </div>
      )}
      {(relatedGala || sameCard.length > 0) && (
        <section class="same-card">
          <h2>Sur la même soirée</h2>
          {relatedGala?.note && <p>{relatedGala.note}</p>}
          {sameCard.length > 0 && (
            <ul>
              {sameCard.map((item) => (
                <li>
                  <a href={item.href}>{item.boxerA} contre {item.boxerB}</a>
                  {item.titles ? ` · ${item.titles}` : item.category ? ` · ${item.category}` : ''}
                </li>
              ))}
            </ul>
          )}
        </section>
      )}
      {prediction.length > 0 && (
        <section class="pronostic">
          <h2>Pronostic</h2>
          {prediction.map((part) => <p>{part}</p>)}
        </section>
      )}
      <nav class="also">
        {fight.article && <a href={`/${fight.article}`}>Lire l'article</a>}
        {relatedGala && <a href={relatedGala.href}>Voir le gala</a>}
        <a href={fight.status === 'dispute' ? '/resultats-boxe' : '/combats-a-venir'}>
          {fight.status === 'dispute' ? 'Tous les résultats' : 'Tous les combats'}
        </a>
      </nav>
    </div>
  </article>
  <Footer slot="footer" />
</Base>
