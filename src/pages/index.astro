---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { boxeurs, clubs, coachs, combats, galas, formatDate, groupArticlesByDay, kindLabel, liveArticle, parisDayKey } from '../data/entities';
import { fightMedia, photosForVersus } from '../lib/portraits';
import { breadcrumbLd, graph, organizationLd, websiteLd } from '../lib/seo';
import DaysNav from '../components/DaysNav.astro';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const une = articles[0] ? { ...articles[0], data: liveArticle(articles[0].data) } : null;
const guth = boxeurs.find((b) => b.slug === 'valentin-guth');
const coachPhoto = coachs.find((c) => c.photo && c.slug !== 'valentin-guth');
const unePhotos = une ? photosForVersus(une.data.coverVersus || '') : [];
const uneImage = une?.data.photo || unePhotos[0] || '/img/og-combat-boxe.jpg';
const editions = groupArticlesByDay(articles);
const todayKey = parisDayKey(new Date());
const upcomingGalasAll = galas
  .filter((gala) => String(gala.date) >= todayKey)
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const upcomingAll = combats
  .filter((c) => c.status === 'a-venir')
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const resultsAll = combats
  .filter((c) => c.status === 'dispute')
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const upcomingGalas = upcomingGalasAll.slice(0, 2);
const upcoming = upcomingAll.slice(0, 2);
const results = resultsAll.slice(0, 2);
const suite = articles.slice(1, 5).map((item) => ({ ...item, data: liveArticle(item.data) }));
const meter = [
  [articles.length, articles.length > 1 ? 'papiers' : 'papier'],
  [upcomingAll.length, upcomingAll.length > 1 ? 'affiches' : 'affiche'],
  [upcomingGalasAll.length, upcomingGalasAll.length > 1 ? 'soirées' : 'soirée'],
  [clubs.length, clubs.length > 1 ? 'salles' : 'salle'],
];
const jsonLd = graph(
  organizationLd,
  websiteLd,
  breadcrumbLd([{ href: '/', label: 'Accueil' }]),
);
---

<Base
  title="Combat de boxe : actualité, calendrier, résultats | Combat Boxe"
  description="Combat Boxe suit les combats de boxe à venir, les résultats, les boxeurs français, les clubs et les entraîneurs, en France et à l'international."
  path="/"
  image={uneImage}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <section class="front">
    <div class="wrap">
      <div class="front-rule">
        <span>La une</span>
        <p>Boxe anglaise, résultats et salles</p>
      </div>
      {une && (
        <a class="front-une" href={`/${une.data.slug}`}>
          <div class:list={['front-une-media', unePhotos.length >= 2 && 'is-split']}>
            {unePhotos.length >= 2 ? (
              <>
                <img src={unePhotos[0]} alt="" width="640" height="800" decoding="async" fetchpriority="high" />
                <img src={unePhotos[1]} alt="" width="640" height="800" decoding="async" />
              </>
            ) : (
              <img src={uneImage} alt={une.data.imageAlt || ''} width="1200" height="800" decoding="async" fetchpriority="high" />
            )}
          </div>
          <div class="front-une-copy">
            <span class="tag">{kindLabel(une.data.kind)}</span>
            <span class="front-date">{formatDate(une.data.date)}</span>
            <h1>{une.data.coverVersus ? une.data.coverVersus.replace(' / ', ' contre ') : une.data.h1}</h1>
            <p>{une.data.description}</p>
            <span class="front-read">Lire le papier</span>
          </div>
        </a>
      )}
      {suite.length > 0 && (
        <div class="front-fil">
          {suite.map((item) => (
            <a href={`/${item.data.slug}`}>
              <span>{formatDate(item.data.date)}</span>
              <strong>{item.data.h1}</strong>
            </a>
          ))}
        </div>
      )}
      <ul class="front-meter">
        {meter.map(([count, label]) => (
          <li><strong>{count}</strong><span>{label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section days-band">
    <div class="wrap">
      <DaysNav editions={editions} label="Actualités par jour" />
    </div>
  </section>

  <section class="section front-agenda">
    <div class="wrap">
      <div class="front-cols">
        <div>
          <div class="section-head">
            <div><span class="eyebrow">Agenda</span><h2>Prochains combats</h2></div>
            <a href="/combats-a-venir">Tous les combats</a>
          </div>
          {upcoming.length === 0 ? (
            <div class="editorial-empty"><strong>Aucun combat annoncé</strong><p>Les prochaines affiches apparaîtront ici.</p></div>
          ) : (
            <div class="front-stack">
              {upcoming.map((c, index) => {
                const media = fightMedia(`${c.boxerA} / ${c.boxerB}`, index, { allowScene: false });
                return (
                  <a class="preview-card" href={c.href || `/combats/${c.slug}`}>
                    {media.srcs.length > 0 && (
                      <span class:list={['preview-media', media.srcs.length > 1 && 'preview-media-split']}>
                        {media.srcs.map((src) => (
                          <img src={src} alt="" width="640" height="800" loading="lazy" decoding="async" />
                        ))}
                      </span>
                    )}
                    <p>{formatDate(c.date)}{c.city ? ` · ${c.city}` : ''}</p>
                    <h3>{c.boxerA} contre {c.boxerB}</h3>
                  </a>
                );
              })}
            </div>
          )}
        </div>
        <div>
          <div class="section-head">
            <div><span class="eyebrow">Verdicts</span><h2>Derniers résultats</h2></div>
            <a href="/resultats-boxe">Tous les résultats</a>
          </div>
          {results.length === 0 ? (
            <p class="empty">Aucun résultat n’est encore publié.</p>
          ) : (
            <div class="front-stack">
              {results.map((c, index) => {
                const media = fightMedia(`${c.boxerA} / ${c.boxerB}`, index, { allowScene: false });
                return (
                  <a class="preview-card" href={c.href || `/combats/${c.slug}`}>
                    {media.srcs.length > 0 && (
                      <span class:list={['preview-media', media.srcs.length > 1 && 'preview-media-split']}>
                        {media.srcs.map((src) => (
                          <img src={src} alt="" width="640" height="800" loading="lazy" decoding="async" />
                        ))}
                      </span>
                    )}
                    <p>{formatDate(c.date)} · {c.winner}</p>
                    <h3>{c.boxerA} contre {c.boxerB}</h3>
                  </a>
                );
              })}
            </div>
          )}
        </div>
        {upcomingGalas.length > 0 && (
          <div>
            <div class="section-head">
              <div><span class="eyebrow">Soirées</span><h2>Galas à venir</h2></div>
              <a href="/galas-boxe">Tous les galas</a>
            </div>
            <div class="front-stack">
              {upcomingGalas.map((gala, index) => {
                const media = fightMedia(gala.versus || '', index, { allowScene: false });
                return (
                  <a class="preview-card" href={gala.href}>
                    {media.srcs.length > 0 && (
                      <span class:list={['preview-media', media.srcs.length > 1 && 'preview-media-split']}>
                        {media.srcs.map((src) => (
                          <img src={src} alt="" width="640" height="800" loading="lazy" decoding="async" />
                        ))}
                      </span>
                    )}
                    <p>{formatDate(gala.date)}{gala.city ? ` · ${gala.city}` : ''}</p>
                    <h3>{gala.name}</h3>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section front-people">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Le ring d'à côté</span><h2>Visages et salles</h2></div>
        <a href="/portraits-boxeurs">Tous les portraits</a>
      </div>
      <div class="front-faces">
        {guth && (
          <a class="front-face" href={`/boxeurs/${guth.slug}`}>
            <img src={guth.photo} alt={guth.photoAlt} width="640" height="800" loading="lazy" decoding="async" />
            <span class="tag">Boxeur</span>
            <h3>{guth.name}</h3>
            <p>{guth.ranking}</p>
          </a>
        )}
        {clubs.map((club) => (
          <a class="front-face" href={`/clubs/${club.slug}`}>
            {club.image && <img src={club.image} alt={club.imageAlt} width="1200" height="750" loading="lazy" decoding="async" />}
            <span class="tag">Salle</span>
            <h3>{club.name}</h3>
            <p>{club.address}</p>
          </a>
        ))}
        <a class="front-face" href="/entraineurs-boxe-francais">
          {coachPhoto?.photo && (
            <img src={coachPhoto.photo} alt="" width="640" height="800" loading="lazy" decoding="async" />
          )}
          <span class="tag">Entraîneurs</span>
          <h3>Guth et Dadi</h3>
          <p>Minimes et Saint-Cyprien</p>
        </a>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Base>
