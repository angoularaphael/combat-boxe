---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { boxeurs, clubs, coachs, combats, galas, formatDate, groupArticlesByDay, kindLabel, liveArticle, parisDayKey } from '../data/entities';
import { photosForVersus } from '../lib/portraits';
import { breadcrumbLd, graph, organizationLd, websiteLd } from '../lib/seo';
import DaysNav from '../components/DaysNav.astro';
import FightCard from '../components/FightCard.astro';
import GalaCard from '../components/GalaCard.astro';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const une = articles[0] ? { ...articles[0], data: liveArticle(articles[0].data) } : null;
const fil = articles.slice(0, 4).map((item) => ({ ...item, data: liveArticle(item.data) }));
const guth = boxeurs.find((b) => b.slug === 'valentin-guth');
const unePhotos = une ? photosForVersus(une.data.coverVersus || '') : [];
const uneImage = une?.data.photo || unePhotos[0] || '/img/og-combat-boxe.jpg';
const editions = groupArticlesByDay(articles);
const todayKey = parisDayKey(new Date());
const upcomingGalas = galas
  .filter((gala) => String(gala.date) >= todayKey)
  .sort((a, b) => String(a.date).localeCompare(String(b.date)))
  .slice(0, 4);
const upcoming = combats
  .filter((c) => c.status === 'a-venir')
  .sort((a, b) => String(a.date).localeCompare(String(b.date)))
  .slice(0, 8);
const results = combats
  .filter((c) => c.status === 'dispute')
  .sort((a, b) => String(b.date).localeCompare(String(a.date)))
  .slice(0, 6);
const jsonLd = graph(
  organizationLd,
  websiteLd,
  breadcrumbLd([{ href: '/', label: 'Accueil' }]),
);
---

<Base
  title="Combat de boxe : actualité, calendrier, résultats | Combat Boxe"
  description="Combat Boxe suit les combats de boxe à venir, les résultats, les boxeurs français, les clubs et les entraîneurs, en France et à l'international."
  path="/"
  image={uneImage}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  <section class="news-hero">
    <div class="wrap">
      <div class="edition-line">
        <span>Combat Boxe</span>
        <p>Actualité, résultats, calendriers et visages de la boxe anglaise</p>
      </div>
      <div class="lead-grid">
        {une && (
          <a class="lead-story lead-story-edito" href={`/${une.data.slug}`}>
            {unePhotos.length >= 2 ? (
              <div class="lead-split" aria-hidden="true">
                <img src={unePhotos[0]} alt="" width="640" height="800" />
                <img src={unePhotos[1]} alt="" width="640" height="800" />
              </div>
            ) : unePhotos[0] ? (
              <img src={unePhotos[0]} alt="" width="1200" height="800" />
            ) : une.data.photo ? (
              <img src={une.data.photo} alt={une.data.imageAlt || ''} width="1200" height="800" />
            ) : null}
            <span class="story-shade"></span>
            <div class="lead-copy">
              <span class="tag">{kindLabel(une.data.kind)}</span>
              <p class="story-date">{formatDate(une.data.date)}</p>
              <h1>{une.data.coverVersus ? une.data.coverVersus.replace(' / ', ' contre ') : une.data.h1}</h1>
              <p>{une.data.description}</p>
              <span class="read-more">Lire l'article</span>
            </div>
          </a>
        )}
        <div class="hero-side">
          <a class="side-story" href="/combats-a-venir">
            <img src="/img/agenda-upcoming.jpg" alt="" width="800" height="450" />
            <div>
              <span class="tag">À suivre</span>
              <h2>Les prochains combats qui vont compter</h2>
              <p>Dates, affiches, catégories et titres en jeu.</p>
            </div>
          </a>
          <div class="side-pair">
            <a class="mini-story" href="/resultats-boxe">
              <img src="/img/agenda-results.jpg" alt="" width="640" height="360" />
              <span class="tag">Résultats</span>
              <h3>Vainqueurs, décisions et analyses</h3>
            </a>
            <a class="mini-story" href="/calendrier-combats-boxe">
              <img src="/img/agenda-calendar.jpg" alt="" width="640" height="360" />
              <span class="tag">Calendrier</span>
              <h3>Les dates à retenir autour du ring</h3>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section quick-access">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Le fil</span>
          <h2>L'essentiel du ring</h2>
        </div>
        <a href="/actualites">Toutes les actualités</a>
      </div>
      <div class="news-list">
        {fil.map((item, index) => (
          <a href={`/${item.data.slug}`} class="news-item">
            <span class="news-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <span class="tag tag-blue">{kindLabel(item.data.kind)}</span>
              <h3>{item.data.h1}</h3>
            </div>
            <span class="news-arrow">Lire</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section days-band">
    <div class="wrap">
      <DaysNav editions={editions} label="Actualités par jour" />
    </div>
  </section>

  <section class="section schedule-block">
    <div class="wrap">
      <div class="section-head section-head-light">
        <div><span class="eyebrow">Agenda</span><h2>Prochains combats</h2></div>
        <a href="/combats-a-venir">Tout le calendrier</a>
      </div>
      {upcoming.length === 0 ? (
        <div class="editorial-empty"><strong>Calendrier à venir</strong><p>Les prochaines affiches apparaîtront ici.</p></div>
      ) : (
        <div class="fight-grid">{upcoming.map((c, index) => (
          <FightCard fight={c} index={index} />
        ))}</div>
      )}
      {upcomingGalas.length > 0 && (
        <div class="home-results">
          <div class="section-head section-head-light">
            <div><span class="eyebrow">Soirées</span><h2>Galas à venir</h2></div>
            <a href="/galas-boxe">Tous les galas</a>
          </div>
          <div class="fight-grid">
            {upcomingGalas.map((gala, index) => (
              <GalaCard gala={gala} index={index} />
            ))}
          </div>
        </div>
      )}
      <div class="home-results">
        <div class="section-head section-head-light">
          <div><span class="eyebrow">Verdicts</span><h2>Derniers résultats</h2></div>
          <a href="/resultats-boxe">Tous les résultats</a>
        </div>
        {results.length === 0 ? (
          <p class="empty">Aucun résultat n’est encore publié.</p>
        ) : (
          <div class="fight-grid">{results.map((c, index) => (
            <FightCard fight={c} index={index} verdict={true} />
          ))}</div>
        )}
      </div>
    </div>
  </section>

  <section class="section discover">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Au-delà du combat</span><h2>Les visages et les salles</h2></div>
        <a href="/portraits-boxeurs">Tous les portraits</a>
      </div>
      <div class="portrait-grid">
        {guth && (
          <a class="portrait-card portrait-card-wide" href={`/boxeurs/${guth.slug}`}>
            <img src={guth.photo} alt={guth.photoAlt} width="800" height="1000" />
            <div>
              <span class="tag">Boxeurs français</span>
              <h3>{guth.name}</h3>
              <p>{guth.ranking}</p>
            </div>
          </a>
        )}
        {clubs.map((club) => (
          <a class="portrait-card portrait-card-salle" href={`/clubs/${club.slug}`}>
            <img src={club.image} alt={club.imageAlt} width="1200" height="750" />
            <div><span class="tag">Clubs</span><h3>{club.name}</h3><p>{club.address}</p></div>
          </a>
        ))}
        <a class="portrait-card" href="/entraineurs-boxe-francais">
          <img src={coachs[0]?.photo || '/img/boxing-ring-corner.jpg'} alt="" width="800" height="1000" />
          <div><span class="tag">Coachs</span><h3>Ceux qui construisent le combat</h3><p>{coachs.length} entraîneur présenté</p></div>
        </a>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Base>
