---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { boxeurs, clubs, coachs, combats, galas, formatDate, groupArticlesByDay, kindLabel, liveArticle, parisDayKey } from '../data/entities';
import { heroImageForArticle, photosForVersus, posterForVersus } from '../lib/portraits';
import {
  currentMonthEditions,
  editionPath,
  editionTitle,
  isUpcomingCombat,
  isUpcomingDate,
  parisTodayKey,
} from '../lib/archive';
import { breadcrumbLd, graph, organizationLd, webPageLd, websiteLd } from '../lib/seo';
import DaysNav from '../components/DaysNav.astro';
import ClipRow from '../components/ClipRow.astro';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const todayKey = parisTodayKey();
const todayArticles = articles.filter((item) => parisDayKey(item.data.date) === todayKey);
const editionArticles = todayArticles.length
  ? todayArticles
  : articles.filter((item) => articles[0] && parisDayKey(item.data.date) === parisDayKey(articles[0].data.date));
const uneEntry = editionArticles[0] || null;
const une = uneEntry ? { ...uneEntry, data: liveArticle(uneEntry.data) } : null;
const guth = boxeurs.find((b) => b.slug === 'valentin-guth');
const coachPhoto = coachs.find((c) => c.photo && c.slug !== 'valentin-guth');
const unePhotos = une ? photosForVersus(une.data.coverVersus || '') : [];
const unePoster = une ? posterForVersus(une.data.coverVersus || '') : '';
const uneHero = une ? heroImageForArticle(une.data) : '';
const uneImage = uneHero || '/img/scene-ropes.jpg';
const editions = groupArticlesByDay(articles);
const upcomingGalasAll = galas
  .filter((gala) => isUpcomingDate(gala.date, todayKey))
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const upcomingAll = combats
  .filter((c) => isUpcomingCombat(c, todayKey))
  .sort((a, b) => String(a.date).localeCompare(String(b.date)));
const resultsAll = combats
  .filter((c) => c.status === 'dispute')
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const upcomingGalas = upcomingGalasAll.slice(0, 2);
const upcoming = upcomingAll.slice(0, 2);
const results = resultsAll.slice(0, 2);
const suite = editionArticles.slice(1).map((item) => ({ ...item, data: liveArticle(item.data) }));
const watch = upcomingAll
  .flatMap((fight) =>
    (fight.clips || []).map((clip) => ({
      ...clip,
      context: `${fight.boxerA} contre ${fight.boxerB}`,
    })),
  )
  .slice(0, 4);
const meter = [
  [articles.length, articles.length > 1 ? 'papiers' : 'papier'],
  [upcomingAll.length, upcomingAll.length > 1 ? 'affiches' : 'affiche'],
  [upcomingGalasAll.length, upcomingGalasAll.length > 1 ? 'soirées' : 'soirée'],
  [clubs.length, clubs.length > 1 ? 'salles' : 'salle'],
];
const homeTitle = 'Combat boxe : actualités, résultats, calendrier | Combat Boxe';
const homeDescription =
  "Combat boxe et combats boxe : actualités boxe, résultats boxe, calendrier boxe et galas de boxe. Combat de boxe en France et à l'international, autour du ring.";
const jsonLd = graph(
  organizationLd,
  websiteLd,
  webPageLd({
    title: homeTitle,
    description: homeDescription,
    path: '/',
    name: 'Combat boxe',
  }),
  breadcrumbLd([{ href: '/', label: 'Accueil' }]),
);
---

<Base
  title={homeTitle}
  description={homeDescription}
  path="/"
  image={uneImage}
  jsonLd={jsonLd}
>
  <Header slot="header" />
  {une && (
    <a class="stage" href={`/${une.data.slug}`}>
      <div class:list={['stage-visual', unePoster && 'is-poster', !unePoster && unePhotos.length >= 2 && 'is-split']}>
        {unePoster ? (
          <img src={unePoster} alt="" width="1400" height="788" decoding="async" fetchpriority="high" />
        ) : unePhotos.length >= 2 ? (
          <>
            <img src={unePhotos[0]} alt="" width="640" height="800" decoding="async" fetchpriority="high" />
            <img src={unePhotos[1]} alt="" width="640" height="800" decoding="async" />
          </>
        ) : (
          <img src={uneImage} alt={une.data.imageAlt || ''} width="1400" height="788" decoding="async" fetchpriority="high" />
        )}
      </div>
      <div class="stage-copy">
        <span class="stage-kicker">La une · {kindLabel(une.data.kind)} · {formatDate(une.data.date)}</span>
        <h2>{une.data.kind === 'resultat' || !une.data.coverVersus ? une.data.h1 : une.data.coverVersus.replace(' / ', ' contre ')}</h2>
        <p>{une.data.description}</p>
      </div>
    </a>
  )}

  <section class="sheet">
    <div class="wrap">
      <h1 class="sheet-brand">Combat boxe : l'actualité des combats de boxe</h1>
      <p class="sheet-line">Les dates, les verdicts et les salles, au même endroit.</p>
      <ul class="sheet-stats">
        {meter.map(([count, label]) => (
          <li><strong>{count}</strong><span>{label}</span></li>
        ))}
      </ul>
      {suite.length > 0 && (
        <>
          <h2 class="sheet-day">{editionTitle(editionArticles[0].data.date)}</h2>
          <ol class="sheet-index">
            {suite.map((item, index) => (
              <li>
                <a href={`/${item.data.slug}`}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{item.data.h1}</strong>
                </a>
              </li>
            ))}
          </ol>
        </>
      )}
      <p class="sheet-more">
        <a href={une ? editionPath(une.data.date) : '/actualites'}>L'édition du jour</a>
        <a href="/actualites">Actualités du mois</a>
        <a href="/archives">Archives</a>
      </p>
      <nav class="sheet-pillars" aria-label="Rubriques boxe">
        <a href="/actualites">Actualités boxe</a>
        <a href="/combats-a-venir">Combats boxe à venir</a>
        <a href="/resultats-boxe">Résultats boxe</a>
        <a href="/calendrier-combats-boxe">Calendrier boxe</a>
        <a href="/galas-boxe">Galas de boxe</a>
        <a href="/championnat-de-france-de-boxe">Championnat de France</a>
        <a href="/clubs-boxe-france">Clubs de boxe</a>
      </nav>
    </div>
  </section>

  <section class="section days-band">
    <div class="wrap">
      <DaysNav
        editions={currentMonthEditions(editions, todayKey)}
        current={todayKey}
        label="Actualités du mois"
      />
      <p class="card-out"><a href="/archives/actualites">Archives des mois passés</a></p>
    </div>
  </section>

  {watch.length > 0 && (
    <section class="section clip-band">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow">À voir</span>
            <h2>Vidéos et interviews</h2>
          </div>
          <a href="/combats-a-venir">Combats à venir</a>
        </div>
        <ClipRow clips={watch} />
      </div>
    </section>
  )}

  <section class="bill">
    <div class="wrap">
      <div class="bill-head">
        <h2>Les prochaines dates</h2>
        <p>Combats, verdicts et soirées.</p>
      </div>
      <div class="bill-grid">
        {upcoming.map((c) => (
          <a class="bill-card" href={c.href || `/combats/${c.slug}`}>
            <span class="bill-mark">Combat</span>
            <span class="bill-date">{formatDate(c.date)}</span>
            <strong>{c.boxerA} contre {c.boxerB}</strong>
            {c.city && <span class="bill-place">{c.city}</span>}
          </a>
        ))}
        {results.map((c) => (
          <a class="bill-card" href={c.href || `/combats/${c.slug}`}>
            <span class="bill-mark">Verdict</span>
            <span class="bill-date">{formatDate(c.date)}</span>
            <strong>{c.boxerA} contre {c.boxerB}</strong>
            <span class="bill-place">{c.winner}</span>
          </a>
        ))}
        {upcomingGalas.map((gala) => (
          <a class="bill-card" href={gala.href}>
            <span class="bill-mark">Soirée</span>
            <span class="bill-date">{formatDate(gala.date)}</span>
            <strong>{gala.name}</strong>
            {gala.city && <span class="bill-place">{gala.city}</span>}
          </a>
        ))}
      </div>
      <a class="bill-go" href="/calendrier-combats-boxe">Ouvrir le calendrier</a>
    </div>
  </section>

  <section class="section front-people">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Le ring d'à côté</span><h2>Visages et salles</h2></div>
        <a href="/portraits-boxeurs">Tous les portraits</a>
      </div>
      <div class="front-faces">
        {guth && (
          <a class="front-face" href={`/boxeurs/${guth.slug}`}>
            <img src={guth.photo} alt={guth.photoAlt} width="640" height="800" loading="lazy" decoding="async" />
            <span class="tag">Boxeur</span>
            <h3>{guth.name}</h3>
            <p>{guth.ranking}</p>
          </a>
        )}
        {clubs.map((club) => (
          <a class="front-face" href={`/clubs/${club.slug}`}>
            {club.image && <img src={club.image} alt={club.imageAlt} width="1200" height="750" loading="lazy" decoding="async" />}
            <span class="tag">Salle</span>
            <h3>{club.name}</h3>
            <p>{club.address}</p>
          </a>
        ))}
        <a class="front-face" href="/entraineurs-boxe-francais">
          {coachPhoto?.photo && (
            <img src={coachPhoto.photo} alt="" width="640" height="800" loading="lazy" decoding="async" />
          )}
          <span class="tag">Entraîneurs</span>
          <h3>Guth et Dadi</h3>
          <p>Minimes et Saint-Cyprien</p>
        </a>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Base>
