---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ['/', 'Accueil'],
  ['/actualites', 'Actualités'],
  ['/combats-a-venir', 'Combats à venir'],
  ['/resultats-boxe', 'Résultats'],
  ['/calendrier-combats-boxe', 'Calendrier'],
  ['/galas-boxe', 'Galas'],
  ['/boxeurs-francais', 'Boxeurs'],
  ['/clubs-boxe-france', 'Clubs'],
  ['/entraineurs-boxe-francais', 'Entraîneurs'],
];
---

<header class="site-header">
  <div class="topline">
    <div class="wrap topline-inner">
      <span>Le média des combats de boxe</span>
      <nav aria-label="Accès rapide">
        <a href="/actualites">France</a>
        <a href="/boxeurs-internationaux">International</a>
        <a href="/calendrier-combats-boxe">Calendrier</a>
      </nav>
    </div>
  </div>
  <input class="nav-toggle" type="checkbox" id="nav-toggle" />
  <div class="wrap header-bar">
    <a class="logo" href="/" aria-label="Combat Boxe, accueil">
      <img src="/img/logo.png" alt="Combat Boxe, l'actu sportive autour du ring" width="234" height="100" />
    </a>
    <label class="nav-burger" for="nav-toggle"><span></span><span></span><span></span><b>Menu</b></label>
  </div>
  <nav class="nav-panel wrap" aria-label="Rubriques">
    {
      links.map(([href, label]) => (
        <a href={href} aria-current={path === href ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>
