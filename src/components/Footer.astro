---
const groups = [
  [
    ['/combat-de-boxe', 'Combat boxe'],
    ['/actualites', 'Actualités boxe'],
    ['/combats-a-venir', 'Combats boxe à venir'],
    ['/resultats-boxe', 'Résultats boxe'],
    ['/calendrier-combats-boxe', 'Calendrier boxe'],
    ['/galas-boxe', 'Galas de boxe'],
    ['/championnat-de-france-de-boxe', 'Championnat de France'],
  ],
  [
    ['/boxeurs-francais', 'Boxeurs français'],
    ['/boxeurs-internationaux', 'Boxeurs internationaux'],
    ['/portraits-boxeurs', 'Portraits'],
    ['/clubs-boxe-france', 'Clubs de boxe'],
    ['/entraineurs-boxe-francais', 'Entraîneurs'],
    ['/analyses', 'Analyses'],
    ['/interviews', 'Interviews'],
    ['/dossiers', 'Dossiers'],
  ],
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/img/logo-white.png" alt="Combat boxe" width="200" height="85" />
      <p>L'actualité des combats de boxe, des boxeurs et des salles, en France et à l'international.</p>
      <p class="footer-signature">Autour du ring, au plus près des faits.</p>
    </div>
    {
      groups.map((links) => (
        <ul>
          {links.map(([href, label]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      ))
    }
    <ul>
      <li><a href="/archives">Archives</a></li>
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/confidentialite">Confidentialité</a></li>
      <li><a href="/a-propos">À propos du média</a></li>
    </ul>
  </div>
  <div class="wrap footer-bottom">
    <span>Combat Boxe</span>
    <span>Média indépendant de boxe anglaise</span>
  </div>
</footer>
