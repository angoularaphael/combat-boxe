---
import { formatDate } from '../data/entities';
import { countryLabel, flagSrc, placeLine } from '../lib/flags';
import { fightMedia } from '../lib/portraits';
import ClipRow from './ClipRow.astro';

const { fight, index = 0, verdict = false } = Astro.props;
const href = fight.href || (fight.article ? `/${fight.article}` : `/combats/${fight.slug}`);
const media = fightMedia(`${fight.boxerA} / ${fight.boxerB}`, index);
const flag = flagSrc(fight.country);
const country = countryLabel(fight.country);
const clips = Array.isArray(fight.clips) ? fight.clips : [];
---

<article class="fight-card fight-card-link" style={`--i: ${index}`}>
  <a class="fight-body" href={href}>
  <div class:list={['fight-media', media.kind === 'portrait' && 'fight-media-portrait', media.kind === 'poster' && 'fight-media-poster', media.kind === 'scene' && 'fight-media-scene', media.srcs.length > 1 && 'fight-media-split']} aria-hidden="true">
    {media.srcs.map((src) => (
      <img src={src} alt="" width="640" height="800" loading="lazy" decoding="async" />
    ))}
  </div>
  <p class="fight-date">
    {flag && (
      <img class="fight-flag" src={flag} alt="" title={country} width="24" height="16" />
    )}
    {formatDate(fight.date)}
    {fight.time ? ` · ${fight.time}` : ''}
    {placeLine('', country) ? ` · ${country}` : ''}
  </p>
  <p class="fight-vs">
    <span class="fight-a">{fight.boxerA}</span>
    <span class="fight-x">contre</span>
    <span class="fight-b">{fight.boxerB}</span>
  </p>
  <p class="fight-place">
    {fight.category}
    {fight.venue ? ` · ${fight.venue}` : fight.city ? ` · ${fight.city}` : ''}
    {fight.channel ? ` · ${fight.channel}` : ''}
  </p>
  {fight.titles ? <p class="fight-belt">{fight.titles}</p> : null}
  {verdict ? (
    <p class="fight-stakes">
      {fight.winner} {fight.method ? `· ${fight.method}` : ''}
      {fight.decision ? ` · ${fight.decision}` : ''}
    </p>
  ) : fight.stakes ? (
    <p class="fight-stakes">{fight.stakes}</p>
  ) : null}
  </a>
  <ClipRow clips={clips} />
</article>
