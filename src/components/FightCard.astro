---
import { formatDate } from '../data/entities';
import { countryLabel, flagSrc } from '../lib/flags';
import { fightMedia } from '../lib/portraits';

const { fight, index = 0, verdict = false } = Astro.props;
const href = fight.href || (fight.article ? `/${fight.article}` : `/combats/${fight.slug}`);
const photos = fightMedia(`${fight.boxerA} / ${fight.boxerB}`, index);
const flag = flagSrc(fight.country);
const country = countryLabel(fight.country);
---

<a class="fight-card fight-card-link" href={href} style={`--i: ${index}`}>
  <div class:list={['fight-media', photos.length > 1 && 'fight-media-split']} aria-hidden="true">
    {photos.map((src) => (
      <img src={src} alt="" width="320" height="400" loading="lazy" />
    ))}
  </div>
  <p class="fight-date">
    {flag && (
      <img class="fight-flag" src={flag} alt="" title={country} width="24" height="16" />
    )}
    {formatDate(fight.date)}
    {country ? ` · ${country}` : ''}
  </p>
  <p class="fight-vs">
    <span class="fight-a">{fight.boxerA}</span>
    <span class="fight-x">contre</span>
    <span class="fight-b">{fight.boxerB}</span>
  </p>
  <p class="fight-place">
    {fight.category}
    {fight.city ? ` · ${fight.city}` : ''}
  </p>
  {fight.titles ? <p class="fight-belt">{fight.titles}</p> : null}
  {verdict ? (
    <p class="fight-stakes">
      {fight.winner} {fight.method ? `· ${fight.method}` : ''}
      {fight.decision ? ` · ${fight.decision}` : ''}
    </p>
  ) : fight.stakes ? (
    <p class="fight-stakes">{fight.stakes}</p>
  ) : null}
</a>
