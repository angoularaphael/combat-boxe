---
import { formatDate } from '../data/entities';
import { countryLabel, flagSrc } from '../lib/flags';
import { fightMedia } from '../lib/portraits';

const { gala, index = 0 } = Astro.props;
const flag = flagSrc(gala.country);
const country = countryLabel(gala.country);
const photos = fightMedia(gala.versus || '', index);
---

<a class="fight-card fight-card-link" href={gala.href} style={`--i: ${index}`}>
  <div class:list={['fight-media', photos.length > 1 && 'fight-media-split']} aria-hidden="true">
    {photos.map((src) => (
      <img src={src} alt="" width="320" height="400" loading="lazy" />
    ))}
  </div>
  <p class="fight-date">
    {flag && (
      <img class="fight-flag" src={flag} alt="" title={country} width="24" height="16" />
    )}
    {formatDate(gala.date)}
    {country ? ` · ${country}` : ''}
  </p>
  <p class="fight-vs">
    <span class="fight-a">{gala.name}</span>
  </p>
  <p class="fight-place">{gala.city}</p>
  {gala.note ? <p class="fight-stakes">{gala.note}</p> : null}
</a>
