---
import { formatDate } from '../data/entities';
import { countryLabel, flagSrc, placeLine } from '../lib/flags';
import { fightMedia } from '../lib/portraits';

const { gala, index = 0 } = Astro.props;
const flag = flagSrc(gala.country);
const country = countryLabel(gala.country);
const media = fightMedia(gala.versus || '', index);
---

<a class="fight-card fight-card-link" href={gala.href} style={`--i: ${index}`}>
  <div class:list={['fight-media', media.kind === 'portrait' && 'fight-media-portrait', media.kind === 'poster' && 'fight-media-poster', media.kind === 'scene' && 'fight-media-scene', media.srcs.length > 1 && 'fight-media-split']} aria-hidden="true">
    {media.srcs.map((src) => (
      <img src={src} alt="" width="640" height="360" loading="lazy" />
    ))}
  </div>
  <p class="fight-date">
    {flag && (
      <img class="fight-flag" src={flag} alt="" title={country} width="24" height="16" />
    )}
    {formatDate(gala.date)}
    {gala.time ? ` · ${gala.time}` : ''}
    {country ? ` · ${country}` : ''}
  </p>
  <p class="fight-vs">
    <span class="fight-a">{gala.name}</span>
  </p>
  <p class="fight-place">{placeLine(gala.city, country)}{gala.channel ? ` · ${gala.channel}` : ''}</p>
  {gala.note ? <p class="fight-stakes">{gala.note}</p> : null}
</a>
