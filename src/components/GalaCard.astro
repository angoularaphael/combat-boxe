---
import { formatDate } from '../data/entities';
import { countryLabel, flagSrc, placeLine } from '../lib/flags';
import { posterForVersus } from '../lib/portraits';

const { gala } = Astro.props;
const flag = flagSrc(gala.country);
const country = countryLabel(gala.country);
const photo = posterForVersus(gala.versus || '');
---

<a class="fight-card fight-card-link" href={gala.href}>
  {photo && (
    <div class="fight-media fight-media-poster" aria-hidden="true">
      <img src={photo} alt="" width="1000" height="625" loading="lazy" decoding="async" />
    </div>
  )}
  <p class="fight-date">
    {flag && (
      <img class="fight-flag" src={flag} alt="" title={country} width="24" height="16" />
    )}
    {formatDate(gala.date)}
    {gala.time ? ` · ${gala.time}` : ''}
    {country ? ` · ${country}` : ''}
  </p>
  <p class="fight-vs">
    <span class="fight-a">{gala.name}</span>
  </p>
  <p class="fight-place">{placeLine(gala.city, country)}{gala.channel ? ` · ${gala.channel}` : ''}</p>
  {gala.note ? <p class="fight-stakes">{gala.note}</p> : null}
</a>
