---
const { kicker = '', versus = '', title = '', meta = '', photos = [] } = Astro.props;
const names = versus.split(' / ').map((part) => part.trim()).filter(Boolean);
const hasPhotos = photos.length > 0;
const isPoster = String(photos[0] || '').includes('/posters/');
const layout = photos.length >= 2 ? 'split' : photos.length === 1 ? 'single' : 'plain';
---

<figure class:list={['cover-edito', hasPhotos && 'cover-edito-photo', layout === 'single' && 'cover-edito-single', isPoster && 'cover-edito-poster']}>
  {layout === 'split' ? (
    <div class="cover-split" aria-hidden="true">
      <img src={photos[0]} alt="" width="640" height="800" />
      <img src={photos[1]} alt="" width="640" height="800" />
    </div>
  ) : layout === 'single' ? (
    <img class="cover-bg cover-bg-portrait" src={photos[0]} alt="" width="640" height="800" />
  ) : null}
  {layout === 'split' && <span class="cover-photo-shade" aria-hidden="true"></span>}
  <div class="cover-copy">
    {layout !== 'single' && <span class="cover-mark" aria-hidden="true"></span>}
    <p class="cover-brand">Combat Boxe</p>
    {kicker && <p class="cover-kicker">{kicker}</p>}
    {names.length >= 2 ? (
      <p class="cover-versus">
        {names[0]} <span>contre</span> {names[1]}
      </p>
    ) : (
      title && <p class="cover-title">{title}</p>
    )}
    {meta && <p class="cover-meta">{meta}</p>}
  </div>
</figure>
