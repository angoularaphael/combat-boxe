PUBLIC_GA_ID=
PUBLIC_GSC_VERIFICATION=

# Production : ANTHROPIC_API_KEY seule. OpenAI et Gemini ne servent pas a l'agent.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optionnel : forcer le modèle
# IA_MODEL=claude-sonnet-4-5

# Process BotHosting (scripts/serveur-production.mjs).
# Jeton d'un compte machine, pas le compte GitHub principal.
# GIT_PUSH_TOKEN=
# AGENT_HOURS=8
# BOT_HTTP_PORT=3000
