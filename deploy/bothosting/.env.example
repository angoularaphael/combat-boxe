# Agent Combat Boxe — copier vers /home/container/.env
# Compte BotHosting separe, comme BOXPLUS. Pas de GitHub Actions
# sur le compte GitHub principal.

BOT_HTTP_PORT=22077
PORT=22077
BOT_REPO_URL=https://github.com/angoularaphael/combat-boxe.git
BOT_REPO_BRANCH=main

# Un article par jour, 8 h heure de Paris
AGENT_HOURS=8

# Claude seul. OpenAI et Gemini ne sont pas utilises par l'agent.
ANTHROPIC_API_KEY=
# IA_MODEL=claude-sonnet-4-5

# Jeton d'un compte machine (autre compte GitHub, pas le principal)
# avec droit d'ecriture sur angoularaphael/combat-boxe.
# Les commits restent signes Raphael. Vercel deploie depuis main.
GIT_PUSH_TOKEN=
GIT_AUTHOR_NAME=Raphael
GIT_AUTHOR_EMAIL=germainraphaelangoulaonambele@gmail.com
