# Agent Combat Boxe — copier vers /home/container/.env
# Compte BotHosting separe, comme BOXPLUS. Pas de GitHub Actions
# sur le compte GitHub principal.

BOT_HTTP_PORT=22077
PORT=22077
BOT_REPO_URL=https://github.com/boxing-center/combat-boxe.git
BOT_REPO_BRANCH=main

# Jusqu'a 6 articles par jour, 8 h heure de Paris
AGENT_HOURS=8
AGENT_ARTICLES=6

# Une seule cle suffit. Ordre : Anthropic, sinon OpenAI (gpt-4.1), sinon Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=
IA_MODEL=gpt-6-luna

# Jeton fine-grained du compte membre de l'org boxing-center.
# https://github.com/settings/personal-access-tokens/new
# Resource owner : boxing-center. Depot : combat-boxe. Contents : Read and write.
# Les commits restent signes Raphael. Vercel deploie depuis main.
GIT_PUSH_TOKEN=
GIT_AUTHOR_NAME=Raphael
GIT_AUTHOR_EMAIL=germainraphaelangoulaonambele@gmail.com
